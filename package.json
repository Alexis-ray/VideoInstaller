{
  "name": "@develon/youtube-dl-rest",
  "version": "2.2.0",
  "bin": "index.js",
  "description": "Windows YouTube and Bilibili video downloader",
  "scripts": {
    "check": "node --check index.js",
    "health": "node -e \"fetch('http://127.0.0.1:2878/y2b/health').then(r=>r.text()).then(t=>console.log(t)).catch(e=>{console.error(e.message);process.exit(1);})\"",
    "release:tools": "powershell -ExecutionPolicy Bypass -File scripts/download-release-tools.ps1",
    "release:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "release:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "release:native:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-native-portable.ps1",
    "release:native:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-native-installer.ps1",
    "start:dev": "nodemon index.js",
    "start": "node index.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1",
    "node-disk-info": "^1.3.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release-build",
    "assets": [
      "package.json"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Alexis-ray/VideoInstaller",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexis-ray/VideoInstaller.git"
  }
}
