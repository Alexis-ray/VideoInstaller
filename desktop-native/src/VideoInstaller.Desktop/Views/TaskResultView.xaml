<UserControl x:Class="VideoInstaller.Desktop.Views.TaskResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            Margin="0,16,0,0"
            Background="{Binding DownloadTask.StatusBackground}"
            BorderBrush="{Binding DownloadTask.StatusForeground}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{Binding DownloadTask.StatusForeground}" Text="任务结果" />
            <TextBlock Margin="0,8,0,0" Foreground="{Binding DownloadTask.StatusForeground}" Text="{Binding DownloadTask.StatusText}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Text="{Binding DownloadTask.OutputDirectory}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DownloadTask.MainFile}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DownloadTask.AudioFile}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DownloadTask.VideoFile}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DownloadTask.TranscodedFile}" TextWrapping="Wrap" />
            <Button Margin="0,10,0,0"
                    Width="120"
                    Command="{Binding OpenOutputDirectoryCommand}"
                    Content="打开目录" />
        </StackPanel>
    </Border>
</UserControl>
