<UserControl x:Class="VideoInstaller.Desktop.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:VideoInstaller.Desktop.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="22" MaxWidth="1180">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Text="{Binding VersionText}" />
                <Button Grid.Column="1"
                        Padding="10,4"
                        Command="{Binding CopyGithubCommand}"
                        Content="复制 GitHub 链接" />
            </Grid>

            <TextBox MinHeight="44"
                      Padding="12,8"
                     Background="#FFFFFF"
                     BorderBrush="#D7DFEA"
                      FontSize="15"
                      Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ParseCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Border Margin="0,14,0,0"
                    Padding="14,12"
                    Background="{Binding StatusBackground}"
                    CornerRadius="8">
                <TextBlock Foreground="{Binding StatusForeground}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,14,0,20"
                    Padding="12"
                    Background="#FFF3E0"
                    BorderBrush="#FF9800"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="提示：你可以选择原始格式下载，或下载并转码为 H.264 MP4。转码会更兼容，但耗时更久。"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <Border Margin="0,10,0,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Background="#EEF4FF"
                        CornerRadius="999">
                    <TextBlock Foreground="#2D5EA8" Text="{Binding SourceTypeText}" />
                </Border>

                <Image Margin="0,16,0,0"
                       MaxWidth="420"
                       MaxHeight="240"
                       HorizontalAlignment="Center"
                       Source="{Binding ThumbnailUrl}" />

                <StackPanel Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasMultipleParts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="分P：" />
                    <ComboBox Width="520"
                              ItemsSource="{Binding Parts}"
                              SelectedItem="{Binding SelectedPart}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>

                <TextBlock Margin="0,10,0,20"
                           Foreground="#666666"
                           Text="先用下拉框明确选择音频和视频品质；下方表格只用于查看详情和单独下载某一路流。主按钮始终使用下拉框中的当前组合。"
                           TextWrapping="Wrap" />

                <Border Margin="0,0,0,18"
                        Padding="12"
                        Background="#F5F8FC"
                        BorderBrush="#D7DFEA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding ParseNote}" TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="音频品质" />
                        <ComboBox MinWidth="320"
                                  ItemsSource="{Binding Audios}"
                                  SelectedItem="{Binding SelectedAudio, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplayText" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="视频品质" />
                        <ComboBox MinWidth="320"
                                  ItemsSource="{Binding Videos}"
                                  SelectedItem="{Binding SelectedVideo, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplayText" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,18"
                        Padding="12,10"
                        Background="#F5F8FC"
                        BorderBrush="#D7DFEA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding CurrentSelectionSummary}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,0,0,8"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="可用音频" />
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          MaxHeight="260"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Audios}"
                          SelectedItem="{Binding SelectedAudio}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="当前选择" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton HorizontalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding FormatId}" Header="格式 ID" Width="88" />
                        <DataGridTextColumn Binding="{Binding ContainerText}" Header="容器格式" Width="92" />
                        <DataGridTextColumn Binding="{Binding BitrateText}" Header="码率" Width="88" />
                        <DataGridTextColumn Binding="{Binding FileSizeText}" Header="大小" Width="96" />
                        <DataGridTextColumn Binding="{Binding Description}" Header="详情" Width="*" MinWidth="240" />
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Padding="10,4"
                                            Command="{Binding DataContext.DownloadSingleAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="仅下载此音频" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,20,0,8"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="可用视频" />
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="False"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Videos}"
                          SelectedItem="{Binding SelectedVideo}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="当前选择" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton HorizontalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding FormatId}" Header="格式 ID" Width="88" />
                        <DataGridTextColumn Binding="{Binding ContainerText}" Header="容器格式" Width="92" />
                        <DataGridTextColumn Binding="{Binding Resolution}" Header="分辨率" Width="92" />
                        <DataGridTextColumn Binding="{Binding VideoCodec}" Header="原始编码" Width="*" MinWidth="220" />
                        <DataGridTextColumn Binding="{Binding BitrateText}" Header="码率" Width="88" />
                        <DataGridTextColumn Binding="{Binding FileSizeText}" Header="大小" Width="96" />
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Padding="10,4"
                                            Command="{Binding DataContext.DownloadSingleVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="仅下载此视频" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Margin="0,20,0,0">
                    <Button Margin="0,0,12,0"
                            Padding="16,10"
                            Command="{Binding DownloadOriginalCommand}"
                            Content="下载已选格式（原始）" />
                    <Button Margin="0,0,12,0"
                            Padding="16,10"
                            Command="{Binding DownloadTranscodeCommand}"
                            Content="下载并转码（H.264 MP4）" />
                    <Button Padding="16,10"
                            Command="{Binding SaveThumbnailCommand}"
                            Content="保存封面到视频目录" />
                </WrapPanel>

                <views:TaskResultView Visibility="{Binding DownloadTask.HasResult, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
