<UserControl x:Class="VideoInstaller.Desktop.Views.SettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="22" MaxWidth="980">
            <TextBlock FontSize="26" FontWeight="Bold" Text="设置" />
            <TextBlock Margin="0,6,0,18"
                       Foreground="#666666"
                       Text="查看运行路径和工具状态，并直接调整数据目录、Cookie、下载目录、日志目录、工具路径与代理配置。保存后，新任务会立即使用。"
                       TextWrapping="Wrap" />

            <Border Padding="14" Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="运行信息" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="运行模式" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding RuntimeMode}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="应用版本" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding AppVersion}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="配置路径" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="Cookie 路径" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding CookiePath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="临时目录" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding TmpDir}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="下载目录" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding DownloadDirCurrent}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="日志目录" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Text="{Binding LogsDir}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Text="数据根目录" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DataRootDir}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14" Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="工具状态" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="yt-dlp 路径" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding YtDlpPath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="yt-dlp 版本" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding YtDlpVersion}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="ffmpeg 路径" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding FfmpegPath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="ffmpeg 版本" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding FfmpegVersion}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,8" FontWeight="SemiBold" Text="JS 运行时路径" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding JsRuntimePath}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,0" FontWeight="SemiBold" Text="JS 运行时版本" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding JsRuntimeVersion}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14" Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="路径与代理编辑" />

                    <TextBlock Margin="0,10,0,6" Text="安装模式数据目录（仅 installed 模式生效）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding InstalledDataRoot, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseInstalledDataRootCommand}" Content="浏览目录" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,8" Command="{Binding RestoreInstalledDataRootDefaultCommand}" Content="恢复默认" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Foreground="#666666" Text="安装版程序文件位于 Program Files 时，建议把配置、Cookie、日志和临时文件放在当前用户可写的数据目录。" TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,6" Text="临时目录" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding TmpDirInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseTmpDirCommand}" Content="浏览目录" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="下载目录" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseDownloadDirCommand}" Content="浏览目录" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="日志目录" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding LogsDirInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseLogsDirCommand}" Content="浏览目录" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="Cookie 文件路径" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding CookiePathInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseCookiePathCommand}" Content="选择文件" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="yt-dlp 路径（高级）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding YtDlpPathInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseYtDlpPathCommand}" Content="选择文件" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="ffmpeg 路径（高级）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding FfmpegPathInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseFfmpegPathCommand}" Content="选择文件" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="JavaScript 运行时路径（高级）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="36" Padding="10,6" Text="{Binding JsRuntimePathInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Command="{Binding BrowseJsRuntimePathCommand}" Content="选择文件" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,8" Command="{Binding RestoreToolPathsDefaultCommand}" Content="恢复工具默认" />
                    </Grid>

                    <TextBlock Margin="0,12,0,6" Text="代理地址（默认预填本地代理；留空表示直连）" />
                    <TextBox MinHeight="36" Padding="10,6" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0" Foreground="#666666" Text="{Binding ProxySummary}" TextWrapping="Wrap" />
                    <CheckBox Margin="0,10,0,0"
                              Content="代理失败时回退直连"
                              IsChecked="{Binding ProxyFallbackDirect}" />

                    <Button Margin="0,14,0,0"
                            Width="140"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            Command="{Binding SaveSettingsCommand}"
                            Content="保存设置" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14" Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Cookie" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding CookieStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Foreground="#666666" Text="Cookie 文件需要使用 Netscape Cookie 格式。YouTube 出现登录验证、真人验证、会员内容或区域限制时，通常需要把已登录浏览器导出的 Cookie 放到上方 Cookie 路径。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button Margin="0,0,12,0" Padding="14,8" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录" />
                <Button Margin="0,0,12,0" Padding="14,8" Command="{Binding OpenLogsDirectoryCommand}" Content="打开日志目录" />
                <Button Padding="14,8" Command="{Binding CopyGithubCommand}" Content="复制 GitHub 链接" />
            </WrapPanel>

            <TextBlock Margin="0,14,0,0"
                       Foreground="{Binding StatusBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
